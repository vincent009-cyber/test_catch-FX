Option Explicit

'========================================================
' Module2
'
' 正式用途：
' 每天 08:30 執行一次市場資料更新
'
' Module1：
' 自動更新市場資料
'========================================================

Private 下一次執行時間 As Date


'========================================================
' 手動立即更新一次
'
' 測試或臨時需要更新時使用
'========================================================

Public Sub 測試立即更新()

    Call 自動更新市場資料

End Sub


'========================================================
' 每天 08:30 自動更新
'
' 執行後：
'
' 08:30
'   ↓
' Yahoo
'   ↓
' 更新六項資料
'   ↓
' 保存歷史資料
'   ↓
' Excel Save
'
' 然後等待隔天 08:30
'========================================================

Public Sub 每日0830更新()

    Call 自動更新市場資料


    '====================================================
    ' 設定下一次執行時間
    '====================================================

    下一次執行時間 = _
        Date + TimeValue("08:30:00")


    ' 如果今天08:30已經過了
    ' 就安排到明天08:30

    If 下一次執行時間 <= Now Then

        下一次執行時間 = _
            下一次執行時間 + 1

    End If


    Application.OnTime _
        EarliestTime:=下一次執行時間, _
        Procedure:="每日0830更新", _
        Schedule:=True

End Sub


'========================================================
' 啟動每天08:30排程
'
' 如果現在不是08:30，
' 不會立即抓資料。
'
' 它只會等待下一個08:30。
'========================================================

Public Sub 啟動0830排程()

    下一次執行時間 = _
        Date + TimeValue("08:30:00")


    If 下一次執行時間 <= Now Then

        下一次執行時間 = _
            下一次執行時間 + 1

    End If


    Application.OnTime _
        EarliestTime:=下一次執行時間, _
        Procedure:="每日0830更新", _
        Schedule:=True


    MsgBox _
        "每日08:30更新已啟動。" & vbCrLf & vbCrLf & _
        "下一次執行：" & _
        Format(下一次執行時間, "yyyy/mm/dd hh:mm:ss"), _
        vbInformation, _
        "08:30排程"

End Sub


'========================================================
' 停止每天08:30排程
'========================================================

Public Sub 停止0830排程()

    On Error Resume Next


    If 下一次執行時間 <> 0 Then

        Application.OnTime _
            EarliestTime:=下一次執行時間, _
            Procedure:="每日0830更新", _
            Schedule:=False

    End If


    下一次執行時間 = 0


    On Error GoTo 0


    MsgBox _
        "每日08:30排程已停止。", _
        vbInformation, _
        "08:30排程"

End Sub



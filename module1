'========================================================
' 歷史資料
'========================================================

Private Sub 儲存歷史資料( _
    ByVal ws As Worksheet, _
    ByVal updateTime As Date, _
    ByVal usdDate As Date, ByVal usd As Double, _
    ByVal jpyDate As Date, ByVal jpy As Double, _
    ByVal eurDate As Date, ByVal eur As Double, _
    ByVal cnyDate As Date, ByVal cny As Double, _
    ByVal twiiDate As Date, ByVal twii As Double, _
    ByVal sp500Date As Date, ByVal sp500 As Double)


    Dim lastRow As Long


    lastRow = _
        ws.Cells( _
            ws.Rows.Count, _
            "A").End(xlUp).Row


    If lastRow < 1 Then
        lastRow = 1
    End If


    '====================================================
    ' 新增一筆
    '====================================================

    lastRow = lastRow + 1


    ws.Cells(lastRow, 1).value = _
        updateTime


    ws.Cells(lastRow, 2).value = _
        usdDate

    ws.Cells(lastRow, 3).value = _
        usd


    ws.Cells(lastRow, 4).value = _
        jpyDate

    ws.Cells(lastRow, 5).value = _
        jpy


    ws.Cells(lastRow, 6).value = _
        eurDate

    ws.Cells(lastRow, 7).value = _
        eur


    ws.Cells(lastRow, 8).value = _
        cnyDate

    ws.Cells(lastRow, 9).value = _
        cny


    ws.Cells(lastRow, 10).value = _
        twiiDate

    ws.Cells(lastRow, 11).value = _
        twii


    ws.Cells(lastRow, 12).value = _
        sp500Date

    ws.Cells(lastRow, 13).value = _
        sp500


    格式化歷史資料 ws

End Sub


